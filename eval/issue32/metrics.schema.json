      "type": "object",
      "additionalProperties": false,
      "required": [
        "tp",
        "fp",
        "fn",
        "precision",
        "recall",
        "f1"
      ],
      "properties": {
        "tp": {
          "type": "integer",
          "minimum": 0
        },
        "fp": {
          "type": "integer",
          "minimum": 0
        },
        "fn": {
          "type": "integer",
          "minimum": 0
        },
        "precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "f1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
