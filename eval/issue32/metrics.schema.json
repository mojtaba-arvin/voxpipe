{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:evaluation:issue32:metrics:v1",
  "title": "VoxPipe extraction silver metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "label_kind",
    "reference_kind",
    "seed",
    "dataset_count",
    "split_counts",
    "split_ratios",
    "fields",
    "overall_micro",
    "overall_macro"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_kind": {
      "const": "synthetic_template"
    },
    "label_kind": {
      "const": "deterministic_rule_silver"
    },
    "reference_kind": {
      "const": "template_generated_reference_not_human_gold"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "dataset_count": {
      "type": "integer",
      "minimum": 1
    },
    "split_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "split_ratios": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "amount",
        "order_id",
        "customer_name"
      ],
      "properties": {
        "date": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tp",
            "fp",
            "fn",
            "precision",
            "recall",
            "f1"
          ],
          "properties": {
            "tp": {
              "type": "integer",
              "minimum": 0
            },
            "fp": {
              "type": "integer",
              "minimum": 0
            },
            "fn": {
              "type": "integer",
              "minimum": 0
            },
            "precision": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "recall": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "f1": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "amount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tp",
            "fp",
            "fn",
            "precision",
            "recall",
            "f1"
          ],
          "properties": {
            "tp": {
              "type": "integer",
              "minimum": 0
            },
            "fp": {
              "type": "integer",
              "minimum": 0
            },
            "fn": {
              "type": "integer",
              "minimum": 0
            },
            "precision": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "recall": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "f1": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "order_id": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tp",
            "fp",
            "fn",
            "precision",
            "recall",
            "f1"
          ],
          "properties": {
            "tp": {
              "type": "integer",
              "minimum": 0
            },
            "fp": {
              "type": "integer",
              "minimum": 0
            },
            "fn": {
              "type": "integer",
              "minimum": 0
            },
            "precision": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "recall": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "f1": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "customer_name": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tp",
            "fp",
            "fn",
            "precision",
            "recall",
            "f1"
          ],
          "properties": {
            "tp": {
              "type": "integer",
              "minimum": 0
            },
            "fp": {
              "type": "integer",
              "minimum": 0
            },
            "fn": {
              "type": "integer",
              "minimum": 0
            },
            "precision": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "recall": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "f1": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "overall_micro": {
      "$ref": "#/$defs/count_metric"
    },
    "overall_macro": {
      "$ref": "#/$defs/score_metric"
    }
  },
  "$defs": {
    "score_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision",
        "recall",
        "f1"
