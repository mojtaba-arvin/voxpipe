{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:evaluation:issue47:cpu-smoke:v1",
  "title": "VoxPipe Qwen3-ASR CPU smoke report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "model_id",
    "model_revision",
    "model_license",
    "device",
    "cpu_count",
    "torch_num_threads",
    "evaluation_language",
    "detected_language",
    "source_kind",
    "sample_source_url",
    "audio_duration_seconds",
    "model_download_seconds",
    "model_size_bytes",
    "model_load_seconds",
    "inference_seconds",
    "real_time_factor",
    "transcript_characters",
    "timestamps_returned",
    "torch_version",
    "transformers_version",
    "python_version",
    "warnings",
    "peak_rss_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "passed"
    },
    "model_id": {
      "const": "Qwen/Qwen3-ASR-0.6B-hf"
    },
    "model_revision": {
      "const": "e8cb6ff5b151ad5c0e49bf9328a9d628efb5def2"
    },
    "model_license": {
      "const": "Apache-2.0"
    },
    "device": {
      "const": "cpu"
    },
    "cpu_count": {
      "type": "integer",
      "minimum": 1
    },
    "evaluation_language": {
      "const": "English"
    },
    "detected_language": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "const": "public_model_card_sample"
    },
    "sample_source_url": {
      "type": "string",
      "format": "uri"
    },
    "audio_duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "model_load_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "inference_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "real_time_factor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "transcript_characters": {
      "type": "integer",
      "minimum": 1
    },
    "timestamps_returned": {
      "const": false
    },
    "torch_version": {
      "type": "string",
      "minLength": 1
    },
    "transformers_version": {
      "const": "5.20.1"
    },
    "python_version": {
      "type": "string",
      "minLength": 1
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "torch_num_threads": {
      "type": "integer",
      "minimum": 1
    },
    "model_download_seconds": {
      "type": "number",
      "minimum": 0
    },
    "model_size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "peak_rss_bytes": {
      "type": "integer",
      "minimum": 1,
      "description": "Peak resident set size of the CPU smoke process in bytes."
    }
  }
}
