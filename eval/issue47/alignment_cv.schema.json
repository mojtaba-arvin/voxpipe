{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:evaluation:issue47:persian-alignment:v1",
  "title": "VoxPipe Persian Common Voice forced-alignment aggregate report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "model_id",
    "model_revision",
    "model_license",
    "whisperx_version",
    "device",
    "model_dtype",
    "sample_rate",
    "batch_size",
    "clip_count",
    "aligned_clip_count",
    "failed_clip_count",
    "word_count",
    "aligned_word_count",
    "alignment_coverage",
    "alignment_intermediate_uploaded",
    "audio_uploaded",
    "transcript_text_uploaded",
    "speaker_ids_used",
    "diarization_status",
    "speaker_segment_count",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },
    "model_id": {
      "const": "jonatasgrosman/wav2vec2-large-xlsr-53-persian"
    },
    "model_revision": {
      "const": "234714078a1398a9db88194c5a40fefe6f376dc1"
    },
    "model_license": {
      "const": "Apache-2.0"
    },
    "whisperx_version": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "const": "cpu"
    },
    "model_dtype": {
      "type": "string",
      "minLength": 1
    },
    "sample_rate": {
      "const": 16000
    },
    "batch_size": {
      "const": 1
    },
    "clip_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "aligned_clip_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "failed_clip_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "word_count": {
      "type": "integer",
      "minimum": 1
    },
    "aligned_word_count": {
      "type": "integer",
      "minimum": 0
    },
    "alignment_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "alignment_intermediate_uploaded": {
      "const": false
    },
    "audio_uploaded": {
      "const": false
    },
    "transcript_text_uploaded": {
      "const": false
    },
    "speaker_ids_used": {
      "const": false
    },
    "diarization_status": {
      "const": "not_evaluated_read_speech"
    },
    "speaker_segment_count": {
      "const": 0
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
