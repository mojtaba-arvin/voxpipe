{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:evaluation:issue47:overlap-manifest:v1",
  "title": "VoxPipe synthetic overlap manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "source_kind",
    "seed",
    "conversation_count",
    "overlap_count",
    "sample_rate",
    "leading_silence_seconds",
    "background_noise_snr_db",
    "noise_seed_policy",
    "tts_runtime",
    "tts_runtime_version",
    "tts_runtime_license",
    "voice_models",
    "voice_model_license",
    "voice_asset_sha256",
    "voice_asset_download_bytes",
    "mean_overlap_seconds",
    "total_mixed_audio_seconds",
    "annotation_file",
    "annotation_sha256",
    "audio_files_generated",
    "audio_files_persisted",
    "audio_artifact_uploaded",
    "transcript_text_uploaded",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "passed"
    },
    "source_kind": {
      "const": "synthetic_template"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "conversation_count": {
      "type": "integer",
      "minimum": 50
    },
    "overlap_count": {
      "type": "integer",
      "minimum": 50
    },
    "sample_rate": {
      "const": 22050
    },
    "tts_runtime": {
      "const": "sherpa-onnx"
    },
    "tts_runtime_version": {
      "const": "1.13.8"
    },
    "tts_runtime_license": {
      "const": "Apache-2.0"
    },
    "voice_models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer",
        "agent"
      ],
      "properties": {
        "customer": {
          "const": "fa_IR-amir-medium-int8"
        },
        "agent": {
          "const": "fa_IR-ganji-medium-int8"
        }
      }
    },
    "voice_model_license": {
      "const": "CC0-1.0"
    },
    "voice_asset_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer",
        "agent"
      ],
      "properties": {
        "customer": {
          "const": "b79dbf0b6b9629a36fd541bfda83817ec12e2697557d87b918638445971eac46"
        },
        "agent": {
          "const": "2ae4658c3a69ef4f92e09d0014f4af31ca6c95e9ae417de3c34544b5e3a98120"
        }
      }
    },
    "voice_asset_download_bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer",
        "agent"
      ],
      "properties": {
        "customer": {
          "type": "integer",
          "minimum": 1
        },
        "agent": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mean_overlap_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "total_mixed_audio_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "annotation_file": {
      "const": "overlap_annotations.jsonl"
    },
    "annotation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "audio_files_generated": {
      "type": "integer",
      "minimum": 50
    },
    "audio_files_persisted": {
      "const": false
    },
    "audio_artifact_uploaded": {
      "const": false
    },
    "transcript_text_uploaded": {
      "const": false
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "leading_silence_seconds": {
      "type": "number",
      "minimum": 0
    },
    "background_noise_snr_db": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "noise_seed_policy": {
      "const": "base_seed_plus_conversation_index"
    }
  }
}
