{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:evaluation:conversation:v1",
  "title": "VoxPipe evaluation conversation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conversation_id",
    "language",
    "source_kind",
    "split",
    "utterances",
    "scenario"
  ],
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "source_kind": {
      "enum": [
        "synthetic_template",
        "read_speech",
        "consented_natural"
      ]
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "test"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "utterances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "utterance_id",
          "speaker_id",
          "text"
        ],
        "properties": {
          "utterance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "speaker_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "reference_slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_name",
        "phone",
        "order_id",
        "amount",
        "date"
      ],
      "properties": {
        "customer_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "order_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "amount": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        }
      }
    },
    "scenario": {
      "enum": [
        "order_confirmation",
        "address_change",
        "refund",
        "callback"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "synthetic_template"
          }
        },
        "required": [
          "source_kind"
        ]
      },
      "then": {
        "required": [
          "seed",
          "reference_slots"
        ]
      }
    }
  ]
}
