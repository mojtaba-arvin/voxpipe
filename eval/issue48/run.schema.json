{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:evaluation:issue48:run:v1",
  "title": "VoxPipe deterministic lexical retrieval run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ranking_method",
    "query_count",
    "corpus_count",
    "seed",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ranking_method": {
      "const": "deterministic_jaccard_lexical_baseline"
    },
    "query_count": {
      "type": "integer",
      "minimum": 1
    },
    "corpus_count": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "split",
          "ranked_passage_ids",
          "scores"
        ],
        "properties": {
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "train",
              "dev",
              "test"
            ]
          },
          "ranked_passage_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "passage_id",
                "jaccard"
              ],
              "properties": {
                "passage_id": {
                  "type": "string",
                  "minLength": 1
                },
                "jaccard": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
