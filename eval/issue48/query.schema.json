{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:evaluation:issue48:query:v1",
  "title": "VoxPipe retrieval silver query",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "query_text",
    "source_passage_id",
    "anchor_terms",
    "language",
    "source_kind",
    "query_kind",
    "split",
    "seed"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "query_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "source_passage_id": {
      "type": "string",
      "minLength": 1
    },
    "anchor_terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "source_kind": {
      "enum": [
        "synthetic_template",
        "read_speech",
        "consented_natural"
      ]
    },
    "query_kind": {
      "const": "deterministic_template_silver"
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "test"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    }
  }
}
