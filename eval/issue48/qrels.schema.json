{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:evaluation:issue48:qrels:v1",
  "title": "VoxPipe heuristic retrieval qrels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_kind",
    "label_kind",
    "seed",
    "threshold",
    "tie_breaking",
    "query_count",
    "corpus_count",
    "split_counts",
    "qrels"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_kind": {
      "enum": [
        "synthetic_template",
        "mixed_or_external",
        "read_speech",
        "consented_natural"
      ]
    },
    "label_kind": {
      "const": "heuristic_lexical_silver"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "threshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "tie_breaking": {
      "const": "passage_id_ascending"
    },
    "query_count": {
      "type": "integer",
      "minimum": 1
    },
    "corpus_count": {
      "type": "integer",
      "minimum": 1
    },
    "split_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "qrels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "passage_id",
          "relevance",
          "jaccard",
          "split"
        ],
        "properties": {
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "passage_id": {
            "type": "string",
            "minLength": 1
          },
          "relevance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "jaccard": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "split": {
            "enum": [
              "train",
              "dev",
              "test"
            ]
          }
        }
      }
    }
  }
}
