{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:evaluation:post-results:v1",
  "title": "VoxPipe cross-group silver evaluation summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "groups",
    "silver_baseline_complete",
    "completion_label",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "attempt",
        "commit_sha",
        "url"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraction",
        "retrieval",
        "speech"
      ],
      "properties": {
        "extraction": {
          "$ref": "#/$defs/group"
        },
        "retrieval": {
          "$ref": "#/$defs/group"
        },
        "speech": {
          "$ref": "#/$defs/group"
        }
      }
    },
    "silver_baseline_complete": {
      "type": "boolean"
    },
    "completion_label": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "silver-baseline-complete",
        null
      ]
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "url",
        "size_bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifact",
        "metrics"
      ],
      "properties": {
        "status": {
          "enum": [
            "success",
            "failure",
            "skipped"
          ]
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "metrics": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    }
  }
}
