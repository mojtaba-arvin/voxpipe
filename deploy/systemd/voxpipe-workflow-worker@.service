[Unit]
Description=VoxPipe durable speech workflow worker for tenant %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=voxpipe
Group=voxpipe
WorkingDirectory=/opt/voxpipe
EnvironmentFile=/etc/voxpipe/workflow-worker.env
Environment=PYTHONPATH=/opt/voxpipe/src
Environment=VOXPIPE_WORKFLOW_TENANT_ID=%i
Environment=VOXPIPE_OBJECT_STORE_ROOT=/var/lib/voxpipe/objects
Environment=VOXPIPE_WORKFLOW_POLL_INTERVAL_SECONDS=1
Environment=VOXPIPE_WORKFLOW_LEASE_SECONDS=60
Environment=VOXPIPE_WORKFLOW_SCAN_LIMIT=100
Environment=VOXPIPE_STT_MODEL_NAME=small
Environment=VOXPIPE_STT_DEVICE=cpu
Environment=VOXPIPE_STT_COMPUTE_TYPE=int8
Environment=VOXPIPE_STT_MODEL_CACHE=/var/lib/voxpipe/models
StateDirectory=voxpipe
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/voxpipe/.venv/bin/python /opt/voxpipe/scripts/run_workflow_worker.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/voxpipe

[Install]
WantedBy=multi-user.target
