FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
RUN groupadd --gid 10001 voxpipe && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin voxpipe
WORKDIR /app
COPY requirements-postgres.txt requirements-embedding.txt ./
RUN python -m pip install --no-cache-dir --disable-pip-version-check -r requirements-postgres.txt -r requirements-embedding.txt
COPY --chown=10001:10001 src ./src
COPY --chown=10001:10001 scripts/run_retrieval_service.py ./scripts/
USER 10001:10001
EXPOSE 8090
CMD ["python", "scripts/run_retrieval_service.py"]
