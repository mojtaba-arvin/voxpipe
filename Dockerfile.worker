FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 voxpipe \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin voxpipe \
    && mkdir -p /var/lib/voxpipe/staging /var/lib/voxpipe/objects \
    && chown -R 10001:10001 /var/lib/voxpipe
WORKDIR /app
COPY requirements-postgres.txt ./
RUN python -m pip install --no-cache-dir --disable-pip-version-check -r requirements-postgres.txt
COPY --chown=10001:10001 src ./src
COPY --chown=10001:10001 migrations ./migrations
COPY --chown=10001:10001 scripts/run_ingestion_worker.py scripts/bootstrap_local_postgres.py ./scripts/
USER 10001:10001
CMD ["python", "scripts/run_ingestion_worker.py"]
