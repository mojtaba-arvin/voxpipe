{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxpipe.example/schemas/persian-gold-record-1.0.0.json",
  "title": "VoxPipe Persian structured extraction gold record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "split",
    "language",
    "transcript_segments",
    "annotations",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "test"
      ]
    },
    "language": {
      "const": "fa-IR"
    },
    "transcript_segments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "events",
        "topics",
        "relations",
        "action_items"
      ],
      "properties": {
        "entities": {
          "$ref": "#/$defs/claims"
        },
        "events": {
          "$ref": "#/$defs/claims"
        },
        "topics": {
          "$ref": "#/$defs/claims"
        },
        "relations": {
          "$ref": "#/$defs/claims"
        },
        "action_items": {
          "$ref": "#/$defs/claims"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "annotator_ids",
        "adjudicator_id",
        "protocol_revision"
      ],
      "properties": {
        "status": {
          "const": "adjudicated"
        },
        "annotator_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adjudicator_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance_ref": {
      "type": "string",
      "maxLength": 256
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "start_char",
        "end_char",
        "quote"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "object",
          "minProperties": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  }
}
