{
  "contract_version": "1.1.0",
  "transport": "stdio",
  "authorization": {
    "tenant_source": "verified bearer-token principal",
    "client_tenant_id_allowed": false
  },
  "tools": [
    {
      "name": "create_ingestion",
      "description": "Create an authenticated batch ingestion session; upload bytes separately through the returned HTTP URL.",
      "scope": "ingestion:write",
      "method": "POST",
      "path": "/v1/ingestions",
      "retry": "Reuse the same idempotency_key for safe retries.",
      "errors": [
        {
          "code": "INVALID_IDEMPOTENCY_KEY",
          "retryable": false
        },
        {
          "code": "INVALID_REQUEST",
          "retryable": false
        },
        {
          "code": "UPLOAD_SIZE_LIMIT",
          "retryable": false
        },
        {
          "code": "INVALID_CHECKSUM",
          "retryable": false
        },
        {
          "code": "INVALID_SOURCE",
          "retryable": false
        },
        {
          "code": "IDEMPOTENCY_CONFLICT",
          "retryable": false
        },
        {
          "code": "UNAUTHENTICATED",
          "retryable": false
        },
        {
          "code": "FORBIDDEN",
          "retryable": false
        },
        {
          "code": "INTERNAL_ERROR",
          "retryable": true
        }
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "idempotency_key",
          "expected_size_bytes",
          "expected_sha256",
          "source"
        ],
        "properties": {
          "idempotency_key": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "expected_size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "content_type_hint": {
            "type": "string",
            "maxLength": 128
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "file_upload",
                  "device_capture",
                  "telephony",
                  "live_stream",
                  "import"
                ]
              },
              "external_reference": {
                "type": "string",
                "maxLength": 2048
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              },
              "declared_by": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "session_id",
          "state",
          "expected_size_bytes",
          "expected_sha256",
          "upload_url"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string"
          },
          "expected_size_bytes": {
            "type": "integer"
          },
          "expected_sha256": {
            "type": "string"
          },
          "upload_url": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_ingestion_status",
      "description": "Get tenant-scoped ingestion session and durable job status.",
      "scope": "ingestion:read",
      "method": "GET",
      "path": "/v1/ingestions/{session_id}",
      "retry": "Retry transient transport and server errors with bounded backoff.",
      "errors": [
        {
          "code": "NOT_FOUND",
          "retryable": false
        },
        {
          "code": "UNAUTHENTICATED",
          "retryable": false
        },
        {
          "code": "FORBIDDEN",
          "retryable": false
        },
        {
          "code": "INTERNAL_ERROR",
          "retryable": true
        }
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "session_id",
          "state",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string"
          },
          "job": {
            "type": "object"
          },
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "failure": {
            "type": "object"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "name": "get_asset",
      "description": "Get public asset metadata without tenant IDs or private storage references.",
      "scope": "ingestion:read",
      "method": "GET",
      "path": "/v1/assets/{asset_id}",
      "retry": "Retry transient transport and server errors with bounded backoff.",
      "errors": [
        {
          "code": "NOT_FOUND",
          "retryable": false
        },
        {
          "code": "UNAUTHENTICATED",
          "retryable": false
        },
        {
          "code": "FORBIDDEN",
          "retryable": false
        },
        {
          "code": "INTERNAL_ERROR",
          "retryable": true
        }
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "asset_id",
          "source",
          "media",
          "integrity",
          "state",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "object"
          },
          "media": {
            "type": "object"
          },
          "integrity": {
            "type": "object"
          },
          "state": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "retention_policy_id": {
            "type": "string"
          },
          "retention_expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "name": "search_assets",
      "description": "Search metadata by asset ID, source kind, MIME type, container format, or codec; not transcript or semantic search.",
      "scope": "ingestion:read",
      "method": "GET",
      "path": "/v1/assets/search",
      "retry": "Retry transient transport and server errors with bounded backoff.",
      "errors": [
        {
          "code": "INVALID_SEARCH_QUERY",
          "retryable": false
        },
        {
          "code": "INVALID_SEARCH_LIMIT",
          "retryable": false
        },
        {
          "code": "UNAUTHENTICATED",
          "retryable": false
        },
        {
          "code": "FORBIDDEN",
          "retryable": false
        },
        {
          "code": "INTERNAL_ERROR",
          "retryable": true
        }
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "items",
          "limit"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "asset_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "retention_policy_id": {
                  "type": "string"
                },
                "retention_expires_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "limit": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "search_transcripts",
      "description": "Search tenant-scoped transcript segments using PostgreSQL full-text search and optional transcript, asset, revision, language, speaker and time filters.",
      "scope": "transcript:read",
      "method": "GET",
      "path": "/v1/transcripts/search",
      "retry": "Retry transient transport and server errors with bounded backoff; search is read-only.",
      "errors": [
        {
          "code": "INVALID_SEARCH_QUERY",
          "retryable": false
        },
        {
          "code": "INVALID_SEARCH_FILTER",
          "retryable": false
        },
        {
          "code": "INVALID_SEARCH_LIMIT",
          "retryable": false
        },
        {
          "code": "INVALID_SEARCH_OFFSET",
          "retryable": false
        },
        {
          "code": "INVALID_TRANSCRIPT_ID",
          "retryable": false
        },
        {
          "code": "INVALID_ASSET_ID",
          "retryable": false
        },
        {
          "code": "INVALID_SPEAKER_ID",
          "retryable": false
        },
        {
          "code": "INVALID_REVISION",
          "retryable": false
        },
        {
          "code": "INVALID_LANGUAGE",
          "retryable": false
        },
        {
          "code": "INVALID_START_MS",
          "retryable": false
        },
        {
          "code": "INVALID_END_MS",
          "retryable": false
        },
        {
          "code": "INVALID_TIME_RANGE",
          "retryable": false
        },
        {
          "code": "UNAUTHENTICATED",
          "retryable": false
        },
        {
          "code": "FORBIDDEN",
          "retryable": false
        },
        {
          "code": "INTERNAL_ERROR",
          "retryable": true
        }
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0
          },
          "transcript_id": {
            "type": "string",
            "format": "uuid"
          },
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,34}$"
          },
          "speaker_id": {
            "type": "string",
            "format": "uuid"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "transcript_id",
                "revision",
                "asset_id",
                "language",
                "provider",
                "model",
                "segment_id",
                "start_ms",
                "end_ms",
                "text",
                "rank"
              ],
              "properties": {
                "transcript_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "revision": {
                  "type": "integer"
                },
                "asset_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "language": {
                  "type": "string"
                },
                "provider": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "model_version": {
                  "type": "string"
                },
                "segment_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "start_ms": {
                  "type": "integer"
                },
                "end_ms": {
                  "type": "integer"
                },
                "text": {
                  "type": "string"
                },
                "speaker_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "rank": {
                  "type": "number"
                }
              }
            }
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
