{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:schema:structured-intelligence:1.0.0",
  "title": "VoxPipe Structured Intelligence v1",
  "description": "Typed claims extracted from an immutable transcript revision. Every claim must cite exact transcript evidence spans.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "asset_id",
    "transcript_id",
    "transcript_revision",
    "provenance",
    "entities",
    "events",
    "topics",
    "relations",
    "action_items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "transcript_id": {
      "type": "string",
      "format": "uuid"
    },
    "transcript_revision": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "entities": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/claim"
          },
          {
            "properties": {
              "value": {
                "$ref": "#/$defs/entityValue"
              }
            }
          }
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/claim"
          },
          {
            "properties": {
              "value": {
                "$ref": "#/$defs/eventValue"
              }
            }
          }
        ]
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/claim"
          },
          {
            "properties": {
              "value": {
                "$ref": "#/$defs/topicValue"
              }
            }
          }
        ]
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/claim"
          },
          {
            "properties": {
              "value": {
                "$ref": "#/$defs/relationValue"
              }
            }
          }
        ]
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/claim"
          },
          {
            "properties": {
              "value": {
                "$ref": "#/$defs/actionItemValue"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "start_char",
        "end_char",
        "quote"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "format": "uuid"
        },
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "word_start_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Inclusive zero-based word index when timing is available."
        },
        "word_end_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Exclusive zero-based word index when timing is available."
        },
        "start_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "end_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "value",
        "evidence",
        "confidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "format": "uuid"
        },
        "value": {
          "type": "object"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "model_version",
        "prompt_version",
        "schema_version",
        "extracted_at"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "entityValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "entity_type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        }
      }
    },
    "eventValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "event_type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "start_time": {
          "type": "string"
        },
        "end_time": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "topicValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "relationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "predicate",
        "object"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "actionItemValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "assignee": {
          "type": "string"
        },
        "due_date": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    }
  }
}
