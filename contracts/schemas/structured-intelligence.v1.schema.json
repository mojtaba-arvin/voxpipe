{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:schema:structured-intelligence:1.0.0",
  "title": "VoxPipe Structured Intelligence v1",
  "description": "Typed claims extracted from an immutable transcript revision. Every claim must cite exact transcript evidence spans.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "asset_id", "transcript_id", "transcript_revision", "provenance", "entities", "events", "topics", "relations", "action_items"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_id": {"type": "string", "format": "uuid"},
    "asset_id": {"type": "string", "format": "uuid"},
    "transcript_id": {"type": "string", "format": "uuid"},
    "transcript_revision": {"type": "integer", "minimum": 1},
    "provenance": {"$ref": "#/$defs/provenance"},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "topics": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "action_items": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["segment_id", "start_char", "end_char", "quote"],
      "properties": {
        "segment_id": {"type": "string", "format": "uuid"},
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "value", "evidence", "confidence"],
      "properties": {
        "claim_id": {"type": "string", "format": "uuid"},
        "value": {"type": "object"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "model_version", "prompt_version", "schema_version", "extracted_at"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 128},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "schema_version": {"const": "1.0.0"},
        "extracted_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}