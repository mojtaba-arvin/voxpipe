{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:schema:speech-corpus-manifest:1.0.0",
  "title": "VoxPipe Speech Corpus Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "dataset_id",
    "dataset_revision",
    "config",
    "split",
    "license",
    "attribution",
    "consent_basis",
    "source_file_sha256",
    "generated_at",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task": {
      "enum": [
        "asr",
        "vad",
        "diarization",
        "language-id"
      ]
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dataset_revision": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128
    },
    "config": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "split": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "consent_basis": {
      "enum": [
        "public-dataset-license",
        "documented-consent",
        "customer-consent"
      ]
    },
    "consent_note": {
      "type": "string"
    },
    "source_file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "audio_sha256",
          "reference_sha256",
          "language",
          "duration_ms",
          "speaker_id",
          "session_id"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "audio_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reference_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1
          },
          "speaker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
