{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:schema:audio-asset:1.0.0",
  "title": "VoxPipe Audio Asset v1",
  "description": "Tenant-scoped metadata and storage reference for an immutable ingested media object containing audio.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "tenant_id",
    "source",
    "media",
    "integrity",
    "storage",
    "state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file_upload",
            "device_capture",
            "telephony",
            "live_stream",
            "import"
          ]
        },
        "external_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "declared_by": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime_type",
        "container_format",
        "duration_ms",
        "size_bytes",
        "sample_rate_hz",
        "channels"
      ],
      "properties": {
        "mime_type": {
          "type": "string",
          "pattern": "^(audio|video)/[a-zA-Z0-9.+-]+$"
        },
        "container_format": {
          "type": "string",
          "enum": [
            "wav",
            "mp3",
            "m4a",
            "mp4",
            "ogg",
            "flac",
            "webm",
            "aac",
            "amr",
            "other"
          ]
        },
        "codec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 384000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "bit_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "channel_layout": {
          "type": "string",
          "maxLength": 64
        },
        "audio_track_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "object_key"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "s3_compatible",
            "gcs",
            "azure_blob",
            "local"
          ]
        },
        "object_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "uploaded",
        "validating",
        "accepted",
        "rejected",
        "deletion_pending",
        "deleted"
      ]
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{2,64}$"
        },
        "detail": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "retention_policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "retention_expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "rejected"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "rejection"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "deleted"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "deleted_at"
        ]
      }
    }
  ]
}
