{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:schema:ingestion-session:1.0.0",
  "title": "VoxPipe Ingestion Session v1",
  "description": "Tenant-scoped lifecycle contract for batch or streaming audio ingestion. It does not prescribe a transport implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "tenant_id",
    "mode",
    "source",
    "state",
    "idempotency_key",
    "created_at",
    "updated_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "mode": {
      "type": "string",
      "enum": [
        "batch",
        "stream"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file_upload",
            "device_capture",
            "telephony",
            "live_stream",
            "import"
          ]
        },
        "external_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "declared_by": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "created",
        "receiving",
        "finalizing",
        "queued",
        "processing",
        "completed",
        "failed",
        "cancelled",
        "expired"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "retention_policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "staging_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "expires_at",
        "heartbeat_at",
        "attempt"
      ],
      "properties": {
        "owner_id": {
          "type": "string",
          "format": "uuid"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "heartbeat_at": {
          "type": "string",
          "format": "date-time"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "received_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_type_hint": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "media_hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mime_type": {
          "type": "string",
          "pattern": "^(audio|video)/[a-zA-Z0-9.+-]+$"
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 384000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{2,64}$"
        },
        "retryable": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "staging_backend": {
      "type": "string",
      "enum": [
        "local",
        "s3_compatible"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "asset_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "failure"
        ]
      }
    }
  ]
}
