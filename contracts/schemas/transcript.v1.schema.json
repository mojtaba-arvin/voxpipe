{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voxpipe:schema:transcript:1.0.0",
  "title": "VoxPipe Transcript v1",
  "description": "Provider-neutral transcript linked to one immutable audio asset. Tenant identity is carried by the authenticated persistence context, not this public payload.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transcript_id", "asset_id", "language", "text", "segments", "speakers", "provenance", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "transcript_id": { "type": "string", "format": "uuid" },
    "asset_id": { "type": "string", "format": "uuid" },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "text": { "type": "string" },
    "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
    "speakers": { "type": "array", "items": { "$ref": "#/$defs/speaker" } },
    "provenance": { "$ref": "#/$defs/provenance" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "text"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_ms", "end_ms", "text"],
      "properties": {
        "segment_id": { "type": "string", "format": "uuid" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "speaker_id": { "type": ["string", "null"], "format": "uuid" },
        "words": { "type": "array", "items": { "$ref": "#/$defs/word" } }
      }
    },
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker_id"],
      "properties": {
        "speaker_id": { "type": "string", "format": "uuid" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "audio_sha256", "generated_at"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_version": { "type": "string", "maxLength": 128 },
        "audio_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
